<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Versatile Notification Component"
          sling:resourceType="cq/gui/components/authoring/dialog">
    <cq:listeners jcr:primaryType="cq:EditListenersConfig"
                  afteredit="REFRESH_PAGE"
                  afterinsert="REFRESH_PAGE"
                  afterchildinsert="REFRESH_PAGE"/>
    <content jcr:primaryType="nt:unstructured"
             sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured"
                  sling:resourceType="granite/ui/components/coral/foundation/tabs"
                  maximized="{Boolean}false">
                <items jcr:primaryType="nt:unstructured" sling:hideChildren="[*]">
                    <propertiesTab jcr:primaryType="nt:unstructured"
                                   jcr:title="Properties"
                                   sling:resourceType="granite/ui/components/coral/foundation/container"
                                   margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured"
                                     sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                     margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <notificationType jcr:primaryType="nt:unstructured"
                                                              sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                              fieldDescription="Select the type of notification."
                                                              fieldLabel="Notification Type"
                                                              name="./notificationType"
                                                              required="{Boolean}true">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <basic jcr:primaryType="nt:unstructured"
                                                           text="Basic"
                                                           value="Basic"/>
                                                    <alert jcr:primaryType="nt:unstructured"
                                                           text="Alert"
                                                           value="Alert"/>
                                                    <interactive jcr:primaryType="nt:unstructured"
                                                                 text="Interactive"
                                                                 value="Interactive"/>
                                                    <timed jcr:primaryType="nt:unstructured"
                                                           text="Timed"
                                                           value="Timed"/>
                                                </items>
                                            </notificationType>
                                            <displayLocation jcr:primaryType="nt:unstructured"
                                                             sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                             fieldDescription="Select where the notification should be displayed."
                                                             fieldLabel="Display Location"
                                                             name="./displayLocation"
                                                             required="{Boolean}true">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <specificPage jcr:primaryType="nt:unstructured"
                                                                 text="Specific Page"
                                                                 value="Specific Page"/>
                                                    <siteWide jcr:primaryType="nt:unstructured"
                                                              text="Site-wide"
                                                              value="Site-wide"/>
                                                </items>
                                            </displayLocation>
                                            <pagePaths jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                       composite="{Boolean}true"
                                                       fieldDescription="Enter the paths of specific pages."
                                                       fieldLabel="Page Path(s)"
                                                       name="./pagePaths">
                                                <field jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/container"
                                                       name="./pagePaths">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <pathfield jcr:primaryType="nt:unstructured"
                                                                   sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                   fieldLabel="Page Path"
                                                                   name="./pagePath"
                                                                   rootPath="/content"/>
                                                    </items>
                                                </field>
                                            </pagePaths>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </propertiesTab>
                    <contentTab jcr:primaryType="nt:unstructured"
                                jcr:title="Content"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured"
                                     sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                     margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <notificationLabel jcr:primaryType="nt:unstructured"
                                                               sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                               fieldDescription="Enter the notification label."
                                                               fieldLabel="Notification Label"
                                                               name="./notificationLabel"
                                                               useFixedInlineToolbar="{Boolean}true"/>
                                            <imageIcon jcr:primaryType="nt:unstructured"
                                                      sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                      fieldDescription="Select an image or icon for the notification."
                                                      fieldLabel="Image/Icon"
                                                      name="./imageIcon"
                                                      rootPath="/content/dam"/>
                                            <backgroundColor jcr:primaryType="nt:unstructured"
                                                             sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                                             fieldDescription="Choose a background color for the notification."
                                                             fieldLabel="Background Color"
                                                             name="./backgroundColor"
                                                             showDefaultColors="{Boolean}true">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <white jcr:primaryType="nt:unstructured" value="#FFFFFF"/>
                                                    <black jcr:primaryType="nt:unstructured" value="#000000"/>
                                                </items>
                                            </backgroundColor>
                                            <textStyle jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                       fieldDescription="Enter CSS styles for the text."
                                                       fieldLabel="Text Style"
                                                       name="./textStyle"/>
                                            <timing jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                    fieldDescription="Set the duration for timed notifications."
                                                    fieldLabel="Timing"
                                                    name="./timing"
                                                    min="{Long}1"
                                                    max="{Long}60"
                                                    step="{Double}1"
                                                    value="5"/>
                                            <linkLabel jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                       fieldDescription="Enter the label for the link."
                                                       fieldLabel="Link Label"
                                                       name="./linkLabel"/>
                                            <linkURL jcr:primaryType="nt:unstructured"
                                                     sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                     fieldDescription="Enter the URL for the link."
                                                     fieldLabel="Link URL"
                                                     name="./linkURL"
                                                     rootPath="/content"/>
                                            <interactionOptions jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkboxgroup"
                                                                fieldDescription="Select interaction options for the notification."
                                                                fieldLabel="Interaction Options"
                                                                name="./interactionOptions">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <dismiss jcr:primaryType="nt:unstructured"
                                                             sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                             text="Dismiss"
                                                             value="Dismiss"/>
                                                    <snooze jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                            text="Snooze"
                                                            value="Snooze"/>
                                                    <secondaryActions jcr:primaryType="nt:unstructured"
                                                                      sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                                      text="Secondary Actions"
                                                                      value="Secondary Actions"/>
                                                </items>
                                            </interactionOptions>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </contentTab>
                    <analyticsTab jcr:primaryType="nt:unstructured"
                                  jcr:title="Analytics"
                                  sling:resourceType="granite/ui/components/coral/foundation/container"
                                  margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured"
                                     sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                     margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <trackInteractions jcr:primaryType="nt:unstructured"
                                                               sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                               fieldDescription="Enable tracking of interactions with the notification."
                                                               text="Track Interactions"
                                                               name="./trackInteractions"
                                                               checked="true"
                                                               uncheckedValue="false"
                                                               value="{Boolean}true"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </analyticsTab>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
<!--  AEM Code Assist V15: AI Generated Code End - -->