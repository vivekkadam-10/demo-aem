<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Adaptive Breadcrumb Navigation"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured" sling:hideChildren="[*]">
                    <propertiesTab jcr:primaryType="nt:unstructured"
                        jcr:title="Properties"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <breadcrumbType jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Breadcrumb Type"
                                                fieldDescription="Select the type of breadcrumb: Static, Dynamic, or Contextual."
                                                name="./breadcrumbType"
                                                required="{Boolean}true">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <static jcr:primaryType="nt:unstructured"
                                                        text="Static"
                                                        value="Static"/>
                                                    <dynamic jcr:primaryType="nt:unstructured"
                                                        text="Dynamic"
                                                        value="Dynamic"/>
                                                    <contextual jcr:primaryType="nt:unstructured"
                                                        text="Contextual"
                                                        value="Contextual"/>
                                                </items>
                                            </breadcrumbType>
                                            <siteStructureSync jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Site Structure Sync"
                                                fieldDescription="Enable synchronization with the site structure for dynamic breadcrumbs."
                                                name="./siteStructureSync"
                                                checked="true"
                                                uncheckedValue="false"
                                                value="{Boolean}true"/>
                                            <breadcrumbTitle jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Breadcrumb Title"
                                                fieldDescription="Enter the title for static breadcrumbs."
                                                name="./breadcrumbTitle"
                                                required="{Boolean}true"/>
                                            <linkManagement jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Link Management"
                                                fieldDescription="Enable manual adjustment of breadcrumb links."
                                                name="./linkManagement"
                                                uncheckedValue="false"
                                                value="{Boolean}true"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </propertiesTab>
                    <styleTab jcr:primaryType="nt:unstructured"
                        jcr:title="Style"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <breadcrumbSeparator jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Breadcrumb Separator"
                                                fieldDescription="Select the separator for breadcrumb items."
                                                name="./breadcrumbSeparator">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <slash jcr:primaryType="nt:unstructured"
                                                        text="Slash (/)"
                                                        value="/"/>
                                                    <pipe jcr:primaryType="nt:unstructured"
                                                        text="Pipe (|)"
                                                        value="|"/>
                                                    <arrow jcr:primaryType="nt:unstructured"
                                                        text="Arrow (→)"
                                                        value="→"/>
                                                </items>
                                            </breadcrumbSeparator>
                                            <breadcrumbItems jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Breadcrumb Items"
                                                fieldDescription="Add breadcrumb items."
                                                name="./breadcrumbItems">
                                                <field jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <textvalue jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Text Value"
                                                            name="./textvalue"/>
                                                        <numbervalue jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldLabel="Number Value"
                                                            name="./numbervalue"/>
                                                    </items>
                                                </field>
                                            </breadcrumbItems>
                                            <fontColor jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                                fieldLabel="Font Color"
                                                fieldDescription="Select the font color for breadcrumb items."
                                                name="./fontColor"
                                                value="#000000"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </styleTab>
                    <accessibilityTab jcr:primaryType="nt:unstructured"
                        jcr:title="Accessibility"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <accessibilitySettings jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                text="Accessibility Settings"
                                                fieldDescription="Enable accessibility settings for the breadcrumb."
                                                name="./accessibilitySettings"
                                                checked="true"
                                                uncheckedValue="false"
                                                value="{Boolean}true"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </accessibilityTab>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
